# Committed template for .claude/.env (which is gitignored).
# Copy this file to .env and fill in values for your machine.

# Absolute path to the Auto-Wiki vault (must contain logs/ and wiki/).
# See docs/configuration.md and docs/architecture.md for why it lives
# outside this repo.
GINARR_VAULT_ROOT=/path/to/obsidian-vaul/Auto-Wiki
